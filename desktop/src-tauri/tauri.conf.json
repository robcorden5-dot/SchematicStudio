{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchematicStudio",
  "version": "0.1.1",
  "identifier": "uk.co.schematicstudio.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SchematicStudio",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 650,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SchematicStudio",
    "shortDescription": "Electrical schematic, terminal, cable and panel layout editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
